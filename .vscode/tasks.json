{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run MockServer",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/MockServer/Tum.Trust.MockServer.csproj"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "default"
      }
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/Tum.Trust.Security.sln"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net5.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Tum.Trust.Security</RootNamespace>
    <AssemblyName>Tum.Trust.Security</AssemblyName>
    <PackageId>Tum.Trust.Security</PackageId>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix>1.4.0</VersionPrefix>
    <Authors>Pasit Tum</Authors>
    <Company>TUM Trust Security</Company>
    <Product>TUM Trust Security (Powered by TUM)</Product>
    <Description>TUM Trust Security — Omnichannel Sovereign Trust &amp; Identity Verification SDK (Powered by TUM). High-performance, offline-first verification engine for ICAO 9303 ePassport NFC (150+ nations), ISO/IEC 18013-5 Mobile Driving License (mDL), Neuromorphic Edge AI Biometrics, Post-Quantum Cryptography (NIST FIPS 204 ML-DSA Dilithium / ML-KEM Kyber), TUMLog ISO 27001 (A.12.4), Thai Computer Crime Act Sec 26 &amp; PDPA Compliance Log Mesh (.NET 5, .NET 8 &amp; .NET 10).</Description>
    <PackageProjectUrl>https://github.com/PasitTum/tum-trust-security</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PasitTum/tum-trust-security</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>identity;passport;icao9303;epassport;nfc;mdl;iso18013-5;biometrics;pqc;post-quantum;dilithium;ml-dsa;kyber;tumlog;audit-log;iso27001;owasp;pdpa;computer-crime-act;tum-trust;sovereign-trust</PackageTags>
    <PackageReadmeFile>PACKAGE_README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>artifacts/nuget</PackageOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Compile Remove="MockServer\**" />
    <EmbeddedResource Remove="MockServer\**" />
    <None Remove="MockServer\**" />
    <Compile Remove="examples\**" />
    <EmbeddedResource Remove="examples\**" />
    <None Remove="examples\**" />
    <Compile Remove="Tum.Log\**" />
    <EmbeddedResource Remove="Tum.Log\**" />
    <None Remove="Tum.Log\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Tum.Log\Tum.Log.csproj" />
  </ItemGroup>

  <!-- Use base x.0.0 minimum versions so consuming apps on any 5.0.x / 8.0.x / 10.0.x patch never hit NU1605 package downgrade errors -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net5.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net5.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Tum.Log</RootNamespace>
    <AssemblyName>Tum.Log</AssemblyName>
    <PackageId>Tum.Log</PackageId>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Authors>Pasit Tum</Authors>
    <Company>TUM Trust Security</Company>
    <Product>TUMLog — Sovereign Application Compliance &amp; Threat Defense Mesh (Powered by TUM)</Product>
    <Description>TUMLog is an enterprise application-layer compliance and real-time threat defense logging mesh (Powered by TUM). Features automated compliance with Thai Computer Crime Act B.E. 2560 Section 26 (90-day WORM immutable storage, NTP Stratum 1 synchronization, SHA-256 Merkle chain of custody), Thai PDPA, GDPR, and ISO/IEC 27001 (A.12.4). Includes AI Modulo-11 Thai Citizen ID and Luhn PAN redaction, bidirectional OWASP Top 10 threat detection and outbound data leak shield.</Description>
    <PackageProjectUrl>https://github.com/PasitTum/tum-trust-security</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PasitTum/tum-trust-security</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>tumlog;logging;audit;compliance;computer-crime-act;section26;pdpa;gdpr;iso27001;owasp;pii-sanitizer;threat-detection;sovereign-mesh;merkle-chain;worm-storage;powered-by-tum</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageOutputPath>..\artifacts\nuget</PackageOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net5.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
